{
  "name": "@tallshort/pi-inclusive-cost",
  "version": "0.2.0",
  "description": "Pi extension that shows inclusive cost for the current session, including supported subagents and delegated workflows, not just the main thread",
  "type": "module",
  "license": "MIT",
  "author": "Serhii Chernenko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tallshort/pi-inclusive-cost.git"
  },
  "homepage": "https://github.com/tallshort/pi-inclusive-cost#readme",
  "bugs": {
    "url": "https://github.com/tallshort/pi-inclusive-cost/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "cost",
    "usage",
    "subagents",
    "statusline"
  ],
  "pi": {
    "extensions": [
      "./inclusive-cost.ts"
    ]
  },
  "files": [
    "inclusive-cost.ts",
    "collectors/**/*.ts",
    "README.md",
    "docs/DESIGN.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "rm -rf .test-dist && tsc -p tsconfig.test.json && node --test .test-dist/inclusive-cost.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.5.2"
}
